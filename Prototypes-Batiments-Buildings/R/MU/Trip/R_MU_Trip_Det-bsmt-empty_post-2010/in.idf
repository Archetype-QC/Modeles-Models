  Model Outdoor Air Node;                 !- Name

OutputControl:ReportingTolerances,
  1.11,                                   !- Tolerance for Time Heating Setpoint Not Met {deltaC}
  1.11;                                   !- Tolerance for Time Cooling Setpoint Not Met {deltaC}

Output:JSON,
  TimeSeriesAndTabular,                   !- Option Type
  No,                                     !- Output JSON
  No,                                     !- Output CBOR
  No;                                     !- Output MessagePack

Output:Table:SummaryReports,
  AllSummary;                             !- Report Name 1

Site:Location,
  QC_MONTREAL-IAP,                        !- Name
  45.47,                                  !- Latitude {deg}
  -73.73,                                 !- Longitude {deg}
  -5,                                     !- Time Zone {hr}
  36;                                     !- Elevation {m}

Site:WaterMainsTemperature,
  CorrelationFromWeatherFile,             !- Calculation Method
  ,                                       !- Temperature Schedule Name
  ,                                       !- Annual Average Outdoor Air Temperature {C}
  ,                                       !- Maximum Difference In Monthly Average Outdoor Air Temperatures {deltaC}
  1,                                      !- Temperature Multiplier {dimensionless}
  0;                                      !- Temperature Offset {deltaC}

