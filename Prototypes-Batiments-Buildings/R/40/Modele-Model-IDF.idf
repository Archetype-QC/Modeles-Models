ZoneControl:Thermostat,
  Thermal Zone 35 Thermostat,             !- Name
  Thermal Zone 35,                        !- Zone or ZoneList Name
  Thermal Zone 35 Thermostat Schedule,    !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,        !- Control 1 Object Type
  Thermostat Setpoint Dual Setpoint 40,   !- Control 1 Name
  ,                                       !- Control 2 Object Type
  ,                                       !- Control 2 Name
  ,                                       !- Control 3 Object Type
  ,                                       !- Control 3 Name
  ,                                       !- Control 4 Object Type
  ,                                       !- Control 4 Name
  0;                                      !- Temperature Difference Between Cutout And Setpoint {deltaC}

Schedule:Compact,
  Thermal Zone 35 Thermostat Schedule,    !- Name
  Thermal Zone 35 Thermostat Schedule Type Limits, !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  4;                                      !- Field 4

ScheduleTypeLimits,
  Thermal Zone 35 Thermostat Schedule Type Limits, !- Name
  0,                                      !- Lower Limit Value {BasedOnField A3}
  4,                                      !- Upper Limit Value {BasedOnField A3}
  DISCRETE;                               !- Numeric Type

ThermostatSetpoint:DualSetpoint,
  Thermostat Setpoint Dual Setpoint 40,   !- Name
  NECB-G-Thermostat Setpoint-Heating,     !- Heating Setpoint Temperature Schedule Name
  NECB-G-Thermostat Setpoint-Cooling;     !- Cooling Setpoint Temperature Schedule Name

ZoneHVAC:EquipmentConnections,
  Thermal Zone 35,                        !- Zone Name
  Thermal Zone 35 Equipment List,         !- Zone Conditioning Equipment List Name
  Thermal Zone 35 Inlet Node List,        !- Zone Air Inlet Node or NodeList Name
  Thermal Zone 35 Exhaust Node List,      !- Zone Air Exhaust Node or NodeList Name
  Node 35;                                !- Zone Air Node Name

NodeList,
  Thermal Zone 35 Inlet Node List,        !- Name
  Node 135;                               !- Node Name 1

NodeList,
  Thermal Zone 35 Exhaust Node List,      !- Name
  Node 134;                               !- Node Name 1

ZoneHVAC:Baseboard:Convective:Electric,
  Elec Baseboard 39,                      !- Name
  Always On Discrete hvac_library,        !- Availability Schedule Name
  ,                                       !- Heating Design Capacity Method
  Autosize,                               !- Heating Design Capacity {W}
  ,                                       !- Heating Design Capacity Per Floor Area {W/m2}
  ,                                       !- Fraction of Autosized Heating Design Capacity
  1;                                      !- Efficiency

ZoneHVAC:PackagedTerminalHeatPump,
  PTHP 39,                                !- Name
  Always On Discrete hvac_library,        !- Availability Schedule Name
  Node 134,                               !- Air Inlet Node Name
